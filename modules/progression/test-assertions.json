  {
    "id": "level-positive",
    "if": [["@player.Level.value", ">=", 1]]
  },
  {
    "id": "xp-non-negative",
    "if": [["@player.XP.current", ">=", 0]]
  },
  {
    "id": "xp-threshold-positive",
    "if": [["@player.XP.threshold", ">=", 1]]
  },
  {
    "id": "level-points-non-negative",
    "if": [["@player.Level.points", ">=", 0]]
  }
]
